# Local development only. Copy to .env at the repository root.
NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

# Keep these credentials and DATABASE_URL in sync. URL-encode special characters.
POSTGRES_USER=commercecore
POSTGRES_PASSWORD=commercecore_local
POSTGRES_DB=commercecore
DATABASE_URL=postgresql://commercecore:commercecore_local@localhost:5432/commercecore?schema=public
REDIS_URL=redis://localhost:6379

# Mailpit captures local mail; sending emails starts in a later phase.
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=CommerceCore <no-reply@example.test>

# Optional override for the browser health proxy. Next.js reads apps/web/.env.local.
# API_INTERNAL_URL=http://localhost:3001
