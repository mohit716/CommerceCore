{
  "name": "commerce-core",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:web": "pnpm --filter @commerce-core/web dev",
    "dev:api": "pnpm --filter @commerce-core/api dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm --filter @commerce-core/api test:integration",
    "test:smoke": "node scripts/smoke.mjs",
    "test:cloudinary": "node scripts/cloudinary-smoke.mjs",
    "admin:promote": "node scripts/promote-admin.mjs",
    "build": "pnpm -r build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:validate": "pnpm --filter @commerce-core/api db:validate",
    "infra:up": "docker compose up -d --wait",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3"
  }
}
